# ===================================================
# ATTACHMENT MANAGEMENT SYSTEM (AMS) ENVIRONMENT CONFIG
# ===================================================

# Environment Mode: 'production' | 'development' | 'test'
NODE_ENV=production

# Server HTTP Port
PORT=5000

# Mandatory: Cryptographically random secret key for JWT signing (Minimum 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_production_jwt_secret_key_32chars

# SQLite Persistent Database File Path
DATABASE_PATH=./database.sqlite

# Strict Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=https://ams.university.ac.ke,https://portal.ams.university.ac.ke

# Upload Storage Directory
UPLOAD_DIR=./uploads

# Logging Level: 'error' | 'warn' | 'info' | 'debug'
LOG_LEVEL=info

# SMTP Configuration (Optional: for notification emails and password reset)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@ams.university.ac.ke
SMTP_PASS=your_smtp_password_here
SMTP_FROM=AMS Notification Service <no-reply@ams.university.ac.ke>
